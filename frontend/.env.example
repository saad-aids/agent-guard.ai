# AgentGuard.ai — Frontend Environment Variables
#
# Copy this file to .env.local and fill in the values from your AWS deployment.
# NEVER commit .env.local to source control.
#
# These variables are injected at build time by Vite (import.meta.env).
# In AWS Amplify, set them in the Amplify Console under App settings > Environment variables.

# Base URL for the AgentGuard API Gateway endpoint.
# Find this in the SAM stack Outputs section after running `sam deploy`,
# or in the AWS Console under API Gateway > Stages.
# Example format: https://{api-id}.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com

# Raw (un-hashed) demo API key used to authenticate requests.
# Generate this key and store it in SSM using scripts/seed_demo_key.py.
# This is the plain-text key value, NOT the SHA-256 hash stored in SSM.
VITE_API_KEY=your-demo-api-key-here

# Developer ID sent with every API request.
# For the MVP this is hardcoded to "demo" and should match the SSM parameter
# created by scripts/seed_demo_key.py.
VITE_DEVELOPER_ID=demo
